<UserControl x:Class="SingleStage.Views.ManageShowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:SingleStage.Views.Shared"
             xmlns:local="clr-namespace:SingleStage.Views"
             xmlns:editorviews="clr-namespace:SingleStage.Views.EditorViews"
             mc:Ignorable="d"
             Background="{StaticResource DefaultBackgroundBrush}"
             Loaded="ManageShowsView_Loaded"
             Unloaded="ManageShowsView_Unloaded"
             PreviewKeyDown="ManageShowsView_PreviewKeyDown"
             d:DesignHeight="650" d:DesignWidth="1000"
             >

    <Grid Margin="6,6,0,6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- header -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Style="{StaticResource PopUpWindowBodyHeadingTextStyle}"
                   Text="Manage Shows"/>

        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Style="{StaticResource PopUpWindowBodyTextStyle}"
                   Text="Select a show to edit or create a new show"/>

        <!-- show list (chronological, formatted without year) -->
        <DataGrid Grid.Row="1"
                  Grid.Column="0"
                  Style="{StaticResource DefaultDataGridStyle}"
                  CellStyle="{StaticResource DefaultDataGridCellStyle}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListOfShows}"
                  SelectedItem="{Binding SelectedShow, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Name}"
                                    Width="239"/>
                <DataGridTextColumn Header="Start"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding StartTime, StringFormat={}{0:ddd MMM d HH:mm}}"
                                    Width="140"/>
                <DataGridTextColumn Header="End"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding EndTime, StringFormat={}{0:ddd MMM d HH:mm}}"
                                    Width="140"/>
                <DataGridTextColumn Header="Ticket price"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding TicketPrice, StringFormat=C}"
                                    Width="100"/>
                <DataGridCheckBoxColumn Header="Sold out"
                                        ElementStyle="{StaticResource DefaultDataGridCheckBoxStyle}"
                                        Binding="{Binding SoldOut}"
                                        Width="65"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1"
              Grid.Column="1"
              >

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- show editor with separated date and time fields -->
            <editorviews:ShowEditorView Grid.Row="0"
                                        DataContext="{Binding Editor}"/>

            <!-- Error message row -->
            <TextBlock Grid.Row="1"
                       Style="{StaticResource PopUpWindowWarningBodyTextStyle}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       />

            <!-- To manage performances -->
            <Button Grid.Row="2"
                    Margin="6"
                    Style="{StaticResource CrudActionBarButtonStyle}"
                    Command="{Binding ManagePerformancesCommand}">
                    <TextBlock Style="{StaticResource PopUpWindowButtonTextStyle}"
                               Text="Manage selected show's performances&#xA;(Saves any changes)"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               />
            </Button>
        </Grid>

        <!-- CRUD action bar -->
        <shared:CrudActionBarView Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Margin="0,0,6,0"/>
    </Grid>

</UserControl>