<UserControl x:Class="SingleStage.Views.EditorViews.ShowEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SingleStage.Views.EditorViews"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800"
             >

    <!-- show editor with separated date and time fields -->
    <Grid Style="{StaticResource EditorGridStyle}"
          IsEnabled="{Binding IsEditing}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Name -->
            <RowDefinition Height="Auto"/>
            <!-- Start date -->
            <RowDefinition Height="Auto"/>
            <!-- Start time -->
            <RowDefinition Height="Auto"/>
            <!-- End date -->
            <RowDefinition Height="Auto"/>
            <!-- End time -->
            <RowDefinition Height="Auto"/>
            <!-- TicketPrice -->
            <RowDefinition Height="Auto"/>
            <!-- SoldOut -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Name -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Style="{StaticResource PopUpWindowBodyTextStyle}"
                   Text="Name"/>
        <TextBox Grid.Row="0"
                 Grid.Column="1"
                 Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Start Date -->
        <TextBlock Grid.Row="1" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Start date"/>
        <DatePicker Grid.Row="1" Grid.Column="1"
                        SelectedDate="{Binding StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource PopUpWindowDatePickerStyle}"/>

        <!-- Start Time (text) -->
        <TextBlock Grid.Row="2" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Start time"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                     Text="{Binding StartTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- End Date -->
        <TextBlock Grid.Row="3" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="End date"/>
        <DatePicker Grid.Row="3" Grid.Column="1"
                        SelectedDate="{Binding EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource PopUpWindowDatePickerStyle}"/>

        <!-- End Time (text) -->
        <TextBlock Grid.Row="4" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="End time"/>
        <TextBox Grid.Row="4" Grid.Column="1"
                     Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                     Text="{Binding EndTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Ticket Price -->
        <TextBlock Grid.Row="5" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Ticket Price"/>
        <TextBox Grid.Row="5" Grid.Column="1"
                     Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                     Text="{Binding TicketPrice, UpdateSourceTrigger=PropertyChanged}"/>

        <!-- Sold Out -->
        <TextBlock Grid.Row="6" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Sold Out"/>
        <CheckBox Grid.Row="6" Grid.Column="1"
                      IsChecked="{Binding SoldOut, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center"
                      Style="{StaticResource PopUpWindowCheckBoxStyle}"/>

    </Grid>
</UserControl>
