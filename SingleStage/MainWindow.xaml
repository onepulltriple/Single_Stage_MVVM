<Window x:Class="SingleStage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SingleStage"
        mc:Ignorable="d"
        xmlns:views="clr-namespace:SingleStage.Views"
        Title="Single Stage Week Overview"
        Height="650" Width="800"
        Background="{StaticResource DefaultBackgroundBrush}"
        >
    
    <DockPanel>
        <!--main menu-->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Manage">
                <MenuItem Header="_Shows"
                          Command="{Binding ManageShowsCommand}"/>
                <MenuItem Header="_Artists"
                          Command="{Binding ManageArtistsCommand}"/>
                <MenuItem Header="_Employees"
                          Command="{Binding ManageEmployeesCommand}"/>
                <MenuItem Header="_Ticketholders"
                          Command="{Binding ManageTicketholdersCommand}"/>
            </MenuItem>

            <MenuItem Header="_Tickets">
                <MenuItem Header="_Sell Tickets"
                          Command="{Binding SellTicketCommand}"/>
            </MenuItem>

            <MenuItem Header="_Reports"
                      Command="{Binding ReportsCommand}"/>
            
            <MenuItem Header="_Exit"
                      Command="{Binding ExitCommand}"/>
        </Menu>

        <!--main content-->
        <Grid Margin="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--week navigation-->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource MainWindowButtonStyle}"
                        Content="&lt; Previous Week"
                        Command="{Binding PreviousWeekCommand}"
                        />
                
                <TextBlock Grid.Column="1"
                           Style="{StaticResource BodyTextStyle}"
                           Text="{Binding WeekDisplayText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="18"
                           FontWeight="Bold"/>
                
                <Button Grid.Column="2"
                        Style="{StaticResource MainWindowButtonStyle}"
                        Content="Today"
                        Command="{Binding TodayCommand}"
                        />

                <Button Grid.Column="3"
                        Style="{StaticResource MainWindowButtonStyle}"
                        Content="Next Week &gt;"
                        Command="{Binding NextWeekCommand}"
                        />
            </Grid>
            
            <!--calendar view-->
            <views:CalendarWeekView
                Grid.Row="1"
                DataContext="{Binding CalendarWeekViewModel}"
                />

            <!-- Selected show information -->
            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="10"
                    BorderBrush="Gray"
                    BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Selected Show"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding CalendarWeekViewModel.SelectedShow.Name,
                                              TargetNullValue=No show selected}"
                               FontSize="15"/>

                </StackPanel>

            </Border>
        </Grid>
    </DockPanel>

</Window>
