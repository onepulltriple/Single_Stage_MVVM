<UserControl x:Class="SingleStage.Views.CalendarWeekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:view="clr-namespace:SingleStage.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="700">
    
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid>

            <Grid.ColumnDefinitions>
                <!-- time labels -->
                <ColumnDefinition Width="50"/>

                <!-- days -->
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <Canvas Grid.Column="0"
                    Style="{StaticResource CalendarTimeScaleStyle}">

                <ItemsControl ItemsSource="{Binding Hours}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Top"
                        Value="{Binding Top}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}"
                           Style="{StaticResource CalendarTimeLabelStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </Canvas>
            
            <Canvas Grid.Column="1"
                    Style="{StaticResource CalendarDayCanvasStyle}">
                <ItemsControl ItemsSource="{Binding Monday}"
                              ItemsPanel="{StaticResource CalendarItemsPanel}"
                              ItemContainerStyle="{StaticResource CalendarShowPresenterStyle}"
                              ItemTemplate="{StaticResource CalendarShowTemplate}"/>
            </Canvas>

            <Canvas Grid.Column="2"
                    Style="{StaticResource CalendarDayCanvasStyle}">
                <ItemsControl ItemsSource="{Binding Tuesday}"
                              ItemsPanel="{StaticResource CalendarItemsPanel}"
                              ItemContainerStyle="{StaticResource CalendarShowPresenterStyle}"
                              ItemTemplate="{StaticResource CalendarShowTemplate}"/>
            </Canvas>

            <Canvas Grid.Column="3"
                    Style="{StaticResource CalendarDayCanvasStyle}">
                <ItemsControl ItemsSource="{Binding Wednesday}"
                              ItemsPanel="{StaticResource CalendarItemsPanel}"
                              ItemContainerStyle="{StaticResource CalendarShowPresenterStyle}"
                              ItemTemplate="{StaticResource CalendarShowTemplate}"/>
            </Canvas>

            <Canvas Grid.Column="4"
                    Style="{StaticResource CalendarDayCanvasStyle}">
                <ItemsControl ItemsSource="{Binding Thursday}"
                              ItemsPanel="{StaticResource CalendarItemsPanel}"
                              ItemContainerStyle="{StaticResource CalendarShowPresenterStyle}"
                              ItemTemplate="{StaticResource CalendarShowTemplate}"/>
            </Canvas>

            <Canvas Grid.Column="5"
                    Style="{StaticResource CalendarDayCanvasStyle}">
                <ItemsControl ItemsSource="{Binding Friday}"
                              ItemsPanel="{StaticResource CalendarItemsPanel}"
                              ItemContainerStyle="{StaticResource CalendarShowPresenterStyle}"
                              ItemTemplate="{StaticResource CalendarShowTemplate}"/>
            </Canvas>

            <Canvas Grid.Column="6"
                    Style="{StaticResource CalendarDayCanvasStyle}">
                <ItemsControl ItemsSource="{Binding Saturday}"
                              ItemsPanel="{StaticResource CalendarItemsPanel}"
                              ItemContainerStyle="{StaticResource CalendarShowPresenterStyle}"
                              ItemTemplate="{StaticResource CalendarShowTemplate}"/>
            </Canvas>

            <Canvas Grid.Column="7"
                    Style="{StaticResource CalendarDayCanvasStyle}">
                <ItemsControl ItemsSource="{Binding Sunday}"
                              ItemsPanel="{StaticResource CalendarItemsPanel}"
                              ItemContainerStyle="{StaticResource CalendarShowPresenterStyle}"
                              ItemTemplate="{StaticResource CalendarShowTemplate}"/>
            </Canvas>

        </Grid>

    </ScrollViewer>
    
</UserControl>
