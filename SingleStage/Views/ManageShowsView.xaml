<UserControl x:Class="SingleStage.Views.ManageShowsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:SingleStage.Views.Shared"
             xmlns:local="clr-namespace:SingleStage.Views"
             mc:Ignorable="d"
             Background="{StaticResource DefaultBackgroundBrush}"
             Loaded="ManageShowsView_Loaded"
             PreviewKeyDown="ManageShowsView_PreviewKeyDown"
             d:DesignHeight="650" d:DesignWidth="1000"
             >

    <Grid Margin="6,6,0,6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- header -->
        <TextBlock Grid.Row="0"
               Grid.Column="0"
               Style="{StaticResource PopUpWindowBodyHeadingTextStyle}"
               Text="Manage Shows"/>

        <TextBlock Grid.Row="0"
               Grid.Column="1"
               Style="{StaticResource PopUpWindowBodyTextStyle}"
               Text="Select a show to edit or create a new show"/>

        <!-- show list (chronological, formatted without year) -->
        <DataGrid Grid.Row="1"
                  Grid.Column="0"
                  Style="{StaticResource DefaultDataGridStyle}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListOfShows}"
                  SelectedItem="{Binding SelectedShow, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                Binding="{Binding Name}"
                                Width="*"/>
                <DataGridTextColumn Header="Start"
                                ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                Binding="{Binding StartTime, StringFormat={}{0:ddd MMM d HH:mm}}"
                                Width="140"/>
                <DataGridTextColumn Header="End"
                                ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                Binding="{Binding EndTime, StringFormat={}{0:ddd MMM d HH:mm}}"
                                Width="140"/>
                <DataGridTextColumn Header="Ticket price"
                                ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                Binding="{Binding TicketPrice, StringFormat=C}"
                                Width="100"/>
                <DataGridCheckBoxColumn Header="Sold out"
                                    ElementStyle="{StaticResource DefaultDataGridCheckBoxStyle}"
                                    Binding="{Binding SoldOut}"
                                    Width="65"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="20,0,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- show editor with separate date/time fields -->
            <Grid Grid.Row="0"
                  IsEnabled="{Binding Editor.IsEditing}">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Name -->
                    <RowDefinition Height="Auto"/>
                    <!-- Start date -->
                    <RowDefinition Height="Auto"/>
                    <!-- Start time -->
                    <RowDefinition Height="Auto"/>
                    <!-- End date -->
                    <RowDefinition Height="Auto"/>
                    <!-- End time -->
                    <RowDefinition Height="Auto"/>
                    <!-- TicketPrice -->
                    <RowDefinition Height="Auto"/>
                    <!-- SoldOut -->
                    <RowDefinition Height="Auto"/>
                    <!-- Error message -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Name -->
                <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Name"/>
                <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                     Text="{Binding Editor.Name, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Start Date -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Start date"/>
                <DatePicker Grid.Row="1" Grid.Column="1"
                        SelectedDate="{Binding Editor.StartDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource PopUpWindowDatePickerStyle}"/>

                <!-- Start Time (text) -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Start time"/>
                <TextBox Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                     Text="{Binding Editor.StartTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- End Date -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="End date"/>
                <DatePicker Grid.Row="3" Grid.Column="1"
                        SelectedDate="{Binding Editor.EndDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Style="{StaticResource PopUpWindowDatePickerStyle}"/>

                <!-- End Time (text) -->
                <TextBlock Grid.Row="4" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="End time"/>
                <TextBox Grid.Row="4" Grid.Column="1"
                     Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                     Text="{Binding Editor.EndTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Ticket Price -->
                <TextBlock Grid.Row="5" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Ticket Price"/>
                <TextBox Grid.Row="5" Grid.Column="1"
                     Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                     Text="{Binding Editor.TicketPrice, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Sold Out -->
                <TextBlock Grid.Row="6" Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Sold Out"/>
                <CheckBox Grid.Row="6" Grid.Column="1"
                      IsChecked="{Binding Editor.SoldOut, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center"
                      Style="{StaticResource PopUpWindowCheckBoxStyle}"/>

                <!-- Error message row -->
                <TextBlock Grid.Row="7"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       Style="{StaticResource PopUpWindowWarningBodyTextStyle}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       />
            </Grid>

            <!-- To manage performances -->
            <Button Grid.Row="1"
                    Margin="6"
                    Style="{StaticResource CrudActionBarButtonStyle}"
                    Command="{Binding ManagePerformancesCommand}">
                    <TextBlock Style="{StaticResource PopUpWindowButtonTextStyle}"
                               Text="Manage selected show's performances&#xA;(Saves any changes)"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               />
            </Button>
        </Grid>

        <!-- CRUD action bar -->
        <shared:CrudActionBarView Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Margin="0,0,6,0"/>
    </Grid>

</UserControl>