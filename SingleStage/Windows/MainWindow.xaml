<Window x:Class="SingleStage.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SingleStage.Windows"
        mc:Ignorable="d"
        xmlns:views="clr-namespace:SingleStage.Views"
        Title="Single Stage Week Overview"
        Background="{StaticResource DefaultBackgroundBrush}"
        Style="{StaticResource MainWindowStyle}"
        >

    <Window.InputBindings>
        <KeyBinding Key="Left"
                Command="{Binding PreviousDayCommand}"/>

        <KeyBinding Key="Right"
                Command="{Binding NextDayCommand}"/>
    </Window.InputBindings>
    
    <DockPanel>
        <!--main menu-->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Manage"
                      Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="_Shows"
                          Style="{StaticResource MainMenuItemStyle}"
                          Command="{Binding ManageShowsCommand}"/>
                <MenuItem Header="_Performances"
                          Style="{StaticResource MainMenuItemStyle}"
                          Command="{Binding ManagePerformancesCommand}"/>
                <MenuItem Header="_Artists"
                          Style="{StaticResource MainMenuItemStyle}"
                          Command="{Binding ManageArtistsCommand}"/>
                <!--<MenuItem Header="_Employees"
                          Command="{Binding ManageEmployeesCommand}"/>-->
                <MenuItem Header="_Ticketholders"
                          Style="{StaticResource MainMenuItemStyle}"
                          Command="{Binding ManageTicketholdersCommand}"/>
            </MenuItem>

            <MenuItem Header="_Tickets"
                      Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="_Sell Tickets"
                          Style="{StaticResource MainMenuItemStyle}"
                          Command="{Binding SellTicketCommand}"/>
            </MenuItem>

            <MenuItem Header="_Print"
                      Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="{Binding PrintFlyerMenuText}"
                          Command="{Binding PrintFlyerCommand}"/>
            </MenuItem>

            <MenuItem Header="_Exit"
                      Style="{StaticResource MainMenuItemStyle}">
                <MenuItem Header="_Quit"
                          Style="{StaticResource MainMenuItemStyle}"
                          Command="{Binding ExitCommand}"/>
            </MenuItem>
        </Menu>

        <!--main content-->
        <Grid Margin="6,0,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--week navigation-->
            <Grid Grid.Row="0"
                  Margin="0,0,0,10">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource MainWindowDynamicButtonStyle}"
                        Command="{Binding PreviousWeekCommand}"
                        >
                    <TextBlock Text="Previous Week"
                       Style="{StaticResource MainWindowButtonTextBlockStyle}"
                       />
                </Button>
                <Button Grid.Column="1"
                        Style="{StaticResource MainWindowDynamicButtonStyle}"
                        Command="{Binding NextWeekCommand}"
                        >
                    <TextBlock Text="Next Week"
                       Style="{StaticResource MainWindowButtonTextBlockStyle}"
                       />
                </Button>

                <TextBlock Grid.Column="2"
                           Style="{StaticResource TitleTextStyle}"
                           Text="{Binding WeekDisplayText}"/>

                <DatePicker Grid.Column="3"
                    Style="{StaticResource PopUpWindowDatePickerStyle}"
                    SelectedDate="{Binding JumpToDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectedDateFormat="Short"
                    FirstDayOfWeek="Monday"
                    ToolTip="Select a date to jump to that week"/>
                
                <Button Grid.Column="4"
                        Style="{StaticResource MainWindowDynamicButtonStyle}"
                        Command="{Binding PreviousDayCommand}">
                    <TextBlock Text="&lt;"
                               Style="{StaticResource MainWindowButtonTextBlockStyle}"/>
                </Button>
                <Button Grid.Column="5"
                        Style="{StaticResource MainWindowDynamicButtonStyle}"
                        Command="{Binding TodayCommand}"
                        >
                    <TextBlock Text="Today"
                       Style="{StaticResource MainWindowButtonTextBlockStyle}"
                       />
                </Button>
                <Button Grid.Column="6"
                        Style="{StaticResource MainWindowDynamicButtonStyle}"
                        Command="{Binding NextDayCommand}">
                    <TextBlock Text="&gt;"
                               Style="{StaticResource MainWindowButtonTextBlockStyle}"/>
                </Button>

            </Grid>
            
            <!--calendar view-->
            <views:CalendarWeekView
                Grid.Row="1"
                DataContext="{Binding CalendarWeekViewModel}"
                />

            <!-- selected show information -->
            <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1">

                <StackPanel>

                    <TextBlock Text="Selected Show"
                               FontSize="16"
                               FontWeight="Bold"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding CalendarWeekViewModel.SelectedShow.Name,
                                  TargetNullValue=No show selected}"
                               FontSize="15"/>

                    <TextBlock FontSize="14">
                        <Run Text="{Binding CalendarWeekViewModel.SelectedShow.StartTime,
                                             StringFormat='{}{0:HH:mm}'}"/>
                        <Run Text=" - "/>
                        <Run Text="{Binding CalendarWeekViewModel.SelectedShow.EndTime,
                                             StringFormat='{}{0:HH:mm}'}"/>
                    </TextBlock>

                    <TextBlock FontSize="14"
                            Text="{Binding SelectedShowTicketCount,
                          StringFormat='Tickets sold: {0}'}"/>

                    <TextBlock FontSize="14"
                                Text="{Binding SelectedShowSoldOutText}"/>

                </StackPanel>

            </Border>

        </Grid>
    </DockPanel>
</Window>
