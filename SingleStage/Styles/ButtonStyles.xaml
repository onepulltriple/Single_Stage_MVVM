<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   
    <Style x:Key="MainWindowButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth"                 Value="40"/>
        <Setter Property="MinHeight"                Value="30"/>
    </Style>

    <Style x:Key="MainWindowDynamicButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MainWindowButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="mainWindowDynamicButtonStyleBorder"
                            Background="{TemplateBinding Background}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource PrimaryButtonBorderBrush}"
                            >
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="mainWindowDynamicButtonStyleBorder"
                                    Property="Background"
                                    Value="{StaticResource ButtonIsMouseOverBackground}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="mainWindowDynamicButtonStyleBorder"
                                    Property="Background"
                                    Value="{StaticResource ButtonIsPressedBackground}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="mainWindowDynamicButtonStyleBorder"
                                    Property="Background"
                                    Value="{StaticResource ButtonIsDisabledBackground}"/>
                            <Setter TargetName="mainWindowDynamicButtonStyleBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource ButtonIsDisabledBorderBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CrudActionBarButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource MainWindowDynamicButtonStyle}">
        <Setter Property="MinWidth"                 Value="200"/>
        <Setter Property="MinHeight"                Value="80"/>
    </Style>

    <Style x:Key="CalendarShowButtonStyle"
       TargetType="Button">
        <Setter Property="Background"                   Value="Transparent"/>
        <Setter Property="BorderThickness"              Value="0"/>
        <Setter Property="Padding"                      Value="2"/>
        <Setter Property="HorizontalContentAlignment"   Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"     Value="Stretch"/>
        <Setter Property="Focusable"                    Value="False"/>
        <Setter Property="Cursor"                       Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="CalendarShowButtonBorder"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="2"
                        CornerRadius="4">
                        <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CalendarShowButtonBorder" Property="BorderBrush" Value="{StaticResource ButtonIsMouseOverBackground}"/>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CalendarShowButtonBorder" Property="BorderBrush" Value="{StaticResource ButtonIsPressedBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>