<UserControl x:Class="SingleStage.Views.CalendarShowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SingleStage.Views"
             xmlns:designtimeviewmodels="clr-namespace:SingleStage.ViewModels.DesignTimeViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="100" 
             d:DesignWidth="250"
             d:DataContext="{d:DesignInstance Type=designtimeviewmodels:CalendarShowDesignTimeViewModel, IsDesignTimeCreatable=True}"
             >
    <Grid>
        <Border
            Height="{Binding Height}"
            d:Height="80"
            Style="{StaticResource CalendarShowBorderStyle}">

            <StackPanel>
                <TextBlock
                    FontWeight="Bold"
                    Text="{Binding Name}" 
                    />

                <TextBlock
                    FontSize="11"
                    Text="{Binding TimeText}" 
                    />
            </StackPanel>
        </Border>

        <Button Command="{Binding DataContext.SelectShowCommand,
                    RelativeSource={RelativeSource AncestorType={x:Type local:CalendarWeekView}}}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource CalendarShowButtonStyle}">
            
            <Button.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick"
                          Command="{Binding DataContext.OpenShowCommand,
                                    RelativeSource={RelativeSource AncestorType={x:Type local:CalendarWeekView}}}"
                          CommandParameter="{Binding}"/>
            </Button.InputBindings>
        </Button>

    </Grid>
</UserControl>
