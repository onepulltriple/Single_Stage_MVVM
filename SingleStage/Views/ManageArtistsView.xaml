<UserControl x:Class="SingleStage.Views.ManageArtistsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shared="clr-namespace:SingleStage.Views.Shared"
             xmlns:editorviews="clr-namespace:SingleStage.Views.EditorViews"
             mc:Ignorable="d"
             Background="{StaticResource DefaultBackgroundBrush}"
             Loaded="ManageArtistsView_Loaded"
             Unloaded="ManageArtistsView_Unloaded"
             PreviewKeyDown="ManageArtistsView_PreviewKeyDown"
             d:DesignHeight="550" d:DesignWidth="1000"
             >

    <Grid Margin="6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- header -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Style="{StaticResource PopUpWindowBodyHeadingTextStyle}"
                   Text="Manage Artists"/>

        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Style="{StaticResource PopUpWindowBodyTextStyle}"
                   Text="Select an artist to edit or create a new artist"/>


        <!-- artist list -->
        <DataGrid Grid.Row="1"
                  Grid.Column="0"
                  Style="{StaticResource DefaultDataGridStyle}"
                  CellStyle="{StaticResource DefaultDataGridCellStyle}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListOfArtists}"
                  SelectedItem="{Binding SelectedArtist, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Name}"
                                    Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1"
              Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- artist editor -->
            <editorviews:ArtistEditorView Grid.Row="0"
                                      DataContext="{Binding Editor}"/>
            
            <!-- error message row -->
            <TextBlock Grid.Row="1"
                       Style="{StaticResource PopUpWindowWarningBodyTextStyle}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"/>
            
        </Grid>
        
        <!-- CRUD action bar -->
        <shared:CrudActionBarView Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"/>

    </Grid>
</UserControl>