<Window x:Class="SingleStage.Windows.EmployeeLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SingleStage.Windows"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Employee Login Window" 
        Width="450" Height="400" 
        Background="CadetBlue"
        >
    <Grid Loaded="GridLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!--headline-->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Text="Employee Login"
            >
        </TextBlock>


        <!--middle section-->
        <TextBlock    
            Grid.Row="1" 
            Grid.Column="0" 
            Name="UI00" 
            Text="Username"
            />
        <TextBox      
            Grid.Row="1" 
            Grid.Column="1" 
            Name="TB00" 
            Text="{Binding enteredUsername}"
            KeyDown="TB00KeyDownHandler"
            />
        <TextBlock    
            Grid.Row="2" 
            Grid.Column="0" 
            Name="UI01" 
            Text="Password"/>
        <PasswordBox  
            Grid.Row="2" 
            Grid.Column="1" 
            Name="PB00" 
            KeyDown="PB00KeyDownHandler"
            />

        <!--lower section-->
        <TextBlock Name="UIErrorMessage"
                   Grid.Row="3" Grid.Column="0" 
                   Grid.ColumnSpan="2"
                   Text=""
                   />

        <!--bottom section-->
        <Button      
            Grid.Row="4" 
            Grid.Column="0" 
            Name="QuitButton" 
            Click="QuitButtonClicked" 
            >
            <TextBlock Text="Quit"/>
        </Button>
        <Button      
            Grid.Row="4" 
            Grid.Column="1" 
            Name="LoginButton" 
            Click="LoginButtonClicked" 
            >
            <TextBlock Text="Login"/>
        </Button>

    </Grid>
</Window>
