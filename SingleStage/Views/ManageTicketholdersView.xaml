<UserControl x:Class="SingleStage.Views.ManageTicketholdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SingleStage.Views.Shared"
             xmlns:local="clr-namespace:SingleStage.Views"
             xmlns:editorviews="clr-namespace:SingleStage.Views.EditorViews"
             mc:Ignorable="d" 
             Background="{StaticResource DefaultBackgroundBrush}"
             Loaded="ManageTicketholdersView_Loaded"
             Unloaded="ManageTicketholdersView_Unloaded"
             PreviewKeyDown="ManageTicketholdersView_PreviewKeyDown"
             d:DesignHeight="550" d:DesignWidth="1000"
             >
    
    <Grid Margin="6">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- header -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Style="{StaticResource PopUpWindowBodyHeadingTextStyle}"
                   Text="Manage Ticketholders"/>

        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Style="{StaticResource PopUpWindowBodyTextStyle}"
                   Text="Select a ticketholder to edit or create a new ticketholder"/>


        <!-- ticketholder list -->
        <DataGrid Grid.Row="1"
                  Grid.Column="0"
                  Style="{StaticResource DefaultDataGridStyle}"
                  CellStyle="{StaticResource DefaultDataGridCellStyle}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListOfTicketholders}"
                  SelectedItem="{Binding SelectedTicketholder, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Birthdate"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Birthdate, StringFormat={}{0:yyyy-MM-dd}}"
                                    Width="0.5*"/>
                
                <DataGridTextColumn Header="Email"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Email}"
                                    Width="*"/>
                
                <DataGridCheckBoxColumn Header="Discount"
                                        ElementStyle="{StaticResource DefaultDataGridCheckBoxStyle}"
                                        Binding="{Binding Discount}"
                                        Width="0.5*"/>
                
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1"
              Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ticketholder editor -->
            <editorviews:TicketholderEditorView Grid.Row="0"
                                                DataContext="{Binding Editor}"/>

            <!-- Error message row -->
            <TextBlock Grid.Row="1"
                       Style="{StaticResource PopUpWindowWarningBodyTextStyle}"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"/>

        </Grid>

        <!-- CRUD action bar -->
        <shared:CrudActionBarView Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"/>

    </Grid>
</UserControl>
