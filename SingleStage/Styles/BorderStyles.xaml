<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--BORDER STYLES-->
    <!--Border is a visual container, which controls how things look-->

    <Style x:Key="NoBorderStyle" 
           TargetType="Border"
           BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="BorderThickness"          Value="0"/>
        <Setter Property="Background"               Value="Transparent"/>
    </Style>


    <!-- Calendar styles -->
    <Style x:Key="CalendarDayBorderStyle"
           TargetType="Border"
           BasedOn="{StaticResource NoBorderStyle}">
        <Setter Property="BorderBrush"              Value="{StaticResource CalendarDayBorderBrush}"/>
        <Setter Property="BorderThickness"          Value="0,0,1,0"/>
    </Style>

    <!-- Calendar show border -->
    <Style x:Key="CalendarShowBorderStyle" 
           TargetType="Border"
           BasedOn="{StaticResource {x:Type Border}}">
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="CornerRadius"             Value="4"/>
        <Setter Property="Background"               Value="CornflowerBlue"/>
        <Setter Property="BorderBrush"              Value="Black"/>
        <Setter Property="Padding"                  Value="4"/>
    </Style>
    <!--<Setter Property="Margin"                   Value="0,0,2,0"/>-->

</ResourceDictionary>