<UserControl x:Class="SingleStage.Views.ManageTicketholdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SingleStage.Views.Shared"
             xmlns:local="clr-namespace:SingleStage.Views"
             mc:Ignorable="d" 
             Background="{StaticResource DefaultBackgroundBrush}"
             Loaded="ManageTicketholdersView_Loaded"
             PreviewKeyDown="ManageTicketholdersView_PreviewKeyDown"
             d:DesignHeight="450" d:DesignWidth="800"
             >
    
    <Grid Margin="6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>


        <!-- header -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Style="{StaticResource PopUpWindowBodyHeadingTextStyle}"
                   Text="Manage Ticketholders"/>

        <TextBlock Grid.Row="0"
                   Grid.Column="1"
                   Style="{StaticResource PopUpWindowBodyTextStyle}"
                   Text="Select a ticketholder to edit or create a new ticketholder"/>


        <!-- ticketholder list -->
        <DataGrid Grid.Row="1"
                  Grid.Column="0"
                  Style="{StaticResource DefaultDataGridStyle}"
                  IsReadOnly="True"
                  AutoGenerateColumns="False"
                  ItemsSource="{Binding ListOfTicketholders}"
                  SelectedItem="{Binding SelectedTicketholder, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Birthdate"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Birthdate, StringFormat={}{0:yyyy-MM-dd}}"
                                    Width="0.5*"/>
                
                <DataGridTextColumn Header="Email"
                                    ElementStyle="{StaticResource DefaultDataGridTextStyle}"
                                    Binding="{Binding Email}"
                                    Width="*"/>
                
                <DataGridCheckBoxColumn Header="Discount"
                                        ElementStyle="{StaticResource DefaultDataGridCheckBoxStyle}"
                                        Binding="{Binding Discount}"
                                        Width="0.5*"/>
                
            </DataGrid.Columns>
        </DataGrid>


        <!-- ticketholder editor -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="20,0,0,0"
              IsEnabled="{Binding Editor.IsEditing}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Name"/>

            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                     Text="{Binding Editor.Name,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Birthdate"/>

            <DatePicker Grid.Row="1"
                        Grid.Column="1"
                        Style="{StaticResource PopUpWindowDatePickerStyle}"
                        SelectedDate="{Binding Editor.Birthdate, 
                                               UpdateSourceTrigger=PropertyChanged}"/>
            
            <TextBlock Grid.Row="2"
                       Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Email"/>

            <TextBox Grid.Row="2"
                     Grid.Column="1"
                     Style="{StaticResource PopUpWindowTextBoxTextStyle}"
                     Text="{Binding Editor.Email,
                                    UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="3"
                       Grid.Column="0"
                       Style="{StaticResource PopUpWindowBodyTextStyle}"
                       Text="Discount"/>

            <CheckBox Grid.Row="3"
                      Grid.Column="1"
                      Style="{StaticResource PopUpWindowCheckBoxStyle}"
                      IsChecked="{Binding Editor.Discount, 
                                          UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>


        <!-- CRUD action bar -->
        <shared:CrudActionBarView Grid.Row="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  />

    </Grid>
    
</UserControl>
